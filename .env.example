# Supabase Configuration
# Copy this file to .env.local and update with your actual Supabase credentials.
# If these variables are not provided, the application will automatically fall back to mock data mode.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
